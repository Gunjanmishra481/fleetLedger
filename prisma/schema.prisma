// FleetLedger data model. SPEC section 4. Postgres (Neon).
// Money columns are integer paise. Enum-like columns are strings (kept from the SQLite MVP).
// Business dates are DATE columns (no time); Prisma reads them as UTC-midnight Dates.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (app runtime)
  directUrl = env("DIRECT_URL") // direct connection (migrations)
}

model Vehicle {
  id            Int      @id @default(autoincrement())
  regNo         String   @unique // upper-case, no spaces
  ownerType     String   @default("OWN") // OWN | MARKET
  model         String? // carrier model/type shown on invoices, e.g. "TR8"
  usualDriverId Int?
  usualDriver   Driver?  @relation("UsualDriver", fields: [usualDriverId], references: [id], onDelete: SetNull)
  active        Boolean  @default(true)
  trips         Trip[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Driver {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  phone     String?
  active    Boolean       @default(true)
  aliases   DriverAlias[]
  trips     Trip[]
  usualFor  Vehicle[]     @relation("UsualDriver")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

/// Alternative spellings that resolve to a driver (JAWAHIR -> JAVAHIR).
model DriverAlias {
  id       Int    @id @default(autoincrement())
  alias    String @unique
  driverId Int
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model Location {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  kind        String // LOADING_POINT | DESTINATION
  district    String?
  consignorId Int? // loading points only: the client trips from here are billed to
  consignor   Consignor?      @relation(fields: [consignorId], references: [id], onDelete: SetNull)
  aliases     LocationAlias[]
  originOf    Trip[]
  stops       TripStop[]
  rateCards   RateCard[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

/// Alternative spellings that resolve to a location (VADODRA -> VADODARA).
model LocationAlias {
  id         Int      @id @default(autoincrement())
  alias      String   @unique
  locationId Int
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

/// The client dealer on a trip (sheet column DEALER).
model Dealer {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  city  String?
  phone String?
  trips Trip[]
}

/// Route standards: freight, diesel, allowance and POD per loading point + destination set.
model RateCard {
  id              Int       @id @default(autoincrement())
  originId        Int
  origin          Location  @relation(fields: [originId], references: [id])
  destinationKey  String // sorted stop location ids joined by "-"
  freight         Int // paise
  stdDieselL      Float
  driverAllowance Int // paise
  podCharge       Int // paise
  effectiveFrom   DateTime  @db.Date
  effectiveTo     DateTime? @db.Date

  @@unique([originId, destinationKey, effectiveFrom])
  @@index([originId, destinationKey])
}

model DieselRate {
  id            Int      @id @default(autoincrement())
  ratePaise     Int // paise per litre
  effectiveFrom DateTime @unique @db.Date
}

model Trip {
  id              Int        @id @default(autoincrement())
  serialNo        Int
  tripDate        DateTime   @db.Date
  monthKey        String // YYYY-MM, for month scoping
  lrNo            String     @unique
  vehicleId       Int? // null only for imported rows with a blank trailer (flagged until fixed)
  vehicle         Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driverId        Int? // nullable only so history with missing drivers can be imported; the form requires it
  driver          Driver?    @relation(fields: [driverId], references: [id])
  originId        Int? // null only for imported rows with a blank loading point (flagged until fixed)
  origin          Location?  @relation(fields: [originId], references: [id], onDelete: Restrict)
  stops           TripStop[]
  carsCount       Int
  dieselL         Float
  dieselRate      Int // paise per litre
  podCharge       Int // paise
  maintenance     Int // paise
  driverAllowance Int // paise
  freight         Int // paise
  // Written only by compute() in src/server/services/trip.ts; stored so summaries can aggregate in SQL.
  dieselAmount    Int
  totalCost       Int
  profit          Int
  dealerId        Int?
  dealer          Dealer?    @relation(fields: [dealerId], references: [id])
  billingStatus   String     @default("UNBILLED") // UNBILLED | INVOICED | PAID
  notes           String?
  // JSON [{ field, note }] of what was blank/unreadable in the imported row; cleared when the trip is saved from the form.
  incomplete      String?
  invoiceId       Int? // set while the trip is on a draft or issued invoice; cleared on cancel
  invoice         Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  vins            TripVin[]
  createdBy       String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([monthKey])
  @@index([vehicleId, tripDate])
  @@index([driverId, tripDate])
  @@index([invoiceId])
}

model TripStop {
  id         Int      @id @default(autoincrement())
  tripId     Int
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  locationId Int
  location   Location @relation(fields: [locationId], references: [id])
  seq        Int

  @@unique([tripId, seq])
  @@index([locationId])
}

model AuditLog {
  id       Int      @id @default(autoincrement())
  at       DateTime @default(now())
  user     String
  entity   String // Trip, Driver, Import, ...
  entityId String
  action   String // CREATE | UPDATE | DELETE | IMPORT
  changes  String // JSON: { field: [old, new] } or a summary object

  @@index([entity, entityId])
}

/// Invoice numbering: prefix (src/config/company.ts) + FY code + running number.
/// startNo is the first running number in that FY when no invoice has used the FY yet.
model InvoiceSeries {
  fy        String   @id // "2627" = Apr 2026–Mar 2027
  startNo   Int
  updatedAt DateTime @updatedAt
}

/// A client billed for trips (consignor), e.g. JKTI.
model Consignor {
  id            Int        @id @default(autoincrement())
  name          String     @unique // short name, e.g. "JKTI"
  billingName   String
  addressLines  String[]
  gstin         String?
  pan           String?
  state         String?
  stateCode     String?
  handlingLabel String? // "Place of Handling" column, e.g. "JKTI (CE)"
  locations     Location[]
  invoices      Invoice[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

/// One car (VIN) carried on a trip, from the client's VIN sheet.
model TripVin {
  id             Int       @id @default(autoincrement())
  tripId         Int
  trip           Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  seq            Int // order within the client's sheet
  vin            String    @unique
  model          String?
  oem            String?
  region         String?
  dealerCode     String?
  dealerName     String?
  dealerLocation String?
  oemInvoiceDate String? // kept exactly as the client wrote it, e.g. "12/10/2026"
  oemInvoiceNo   String?
  lotNo          String?
  loafNo         String?
  lastMileTpt    String?
  carrierNo      String? // as on the client's sheet (checked against the trip's trailer)
  dispatchDate   DateTime? @db.Date // client's dispatch date (can differ from the trip date)

  @@index([tripId])
}

model Invoice {
  id            Int       @id @default(autoincrement())
  number        String?   @unique // null while a draft; e.g. "MKLAMD2627108"
  fy            String? // "2627"
  seq           Int? // running number within the FY when the number follows the series
  consignorId   Int
  consignor     Consignor @relation(fields: [consignorId], references: [id])
  invoiceDate   DateTime  @db.Date
  period        String // "2026-2027"
  placeOfSupply String
  subtotal      Int // paise
  igst          Int // paise
  cgst          Int // paise
  sgst          Int // paise
  roundOff      Int // paise, can be negative
  total         Int // paise
  status        String    @default("DRAFT") // DRAFT | ISSUED | PAID | CANCELLED
  // Frozen at issue so the document never changes afterwards (JSON).
  seller        String?
  buyer         String?
  lines         String?
  vinRows       String?
  trips         Trip[]
  createdBy     String
  issuedAt      DateTime?
  paidAt        DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([fy, seq])
  @@index([consignorId, status])
}
